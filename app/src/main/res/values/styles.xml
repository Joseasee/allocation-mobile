<resources>
    <!-- Cartões (setores, pessoas, opções) -->
    <style name="Cartao" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/branco</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/borda</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/azul_claro</item>
    </style>

    <!-- Botões grandes e arredondados -->
    <style name="Botao" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Campos de texto com cantos suaves -->
    <style name="CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Botão de ícone (voltar, menu, editar, excluir) -->
    <style name="BotaoIcone">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/texto_suave</item>
    </style>

    <!-- Textos -->
    <style name="TextoTitulo">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextoCorpo">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextoSuave">
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
